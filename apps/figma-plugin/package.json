{
  "name": "figma-plugin",
  "private": true,
  "description": "Figma plugin for Hyperlocalise OAuth, text extraction, and translation jobs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "vp build && vp build --config vite.code.config.ts",
    "build:ui": "vp build",
    "build:code": "vp build --config vite.code.config.ts",
    "dev": "concurrently -n ui,code \"vp build --watch --mode development\" \"vp build --config vite.code.config.ts --watch\""
  },
  "dependencies": {
    "@create-figma-plugin/ui": "4.0.3",
    "@create-figma-plugin/utilities": "4.0.3",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "24.19.2",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "packageManager": "pnpm@12.18.0"
}
