{
  "name": "figma-plugin",
  "private": true,
  "description": "Figma plugin for Hyperlocalise OAuth, text extraction, and translation jobs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "vp build && vp build --config vite.code.config.ts",
    "build:ui": "vp build",
    "build:code": "vp build --config vite.code.config.ts",
    "dev": "concurrently -n ui,code \"vp build --watch\" \"vp build --config vite.code.config.ts --watch\""
  },
  "dependencies": {
    "@create-figma-plugin/ui": "4.0.3",
    "@create-figma-plugin/utilities": "4.0.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "24.19.2",
    "concurrently": "^10.0.6",
    "dotenv": "18.0.8",
    "jsdom": "^30.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "packageManager": "pnpm@12.14.0"
}
