{
  "name": "figma-plugin",
  "private": true,
  "description": "Figma plugin for Hyperlocalise OAuth, text extraction, and translation jobs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "vp build && vp build --config vite.code.config.ts",
    "build:ui": "vp build",
    "build:code": "vp build --config vite.code.config.ts",
    "dev": "concurrently -n ui,code \"vp build --watch\" \"vp build --config vite.code.config.ts --watch\""
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.123.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "jsdom": "^30.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "packageManager": "pnpm@11.25.0"
}
