        "handler_test.go",
        "request_log_test.go",
        "server_test.go",
        "spellcheck_test.go",
    ],
    embed = [":go_svc"],
    deps = [
        "//apps/go-svc/internal/ironsession",
        "//internal/i18n/segmentvalidate",
        "//internal/i18n/spellcheck",
        "@com_github_stretchr_testify//require",
