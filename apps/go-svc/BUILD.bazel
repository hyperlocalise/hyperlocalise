load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "go_svc",
    srcs = [
        "auth.go",
        "handler.go",
        "main.go",
        "request_log.go",
        "spellcheck.go",
        "spellcheck_provider_default.go",
    ],
    importpath = "github.com/hyperlocalise/hyperlocalise/apps/go-svc",
    visibility = ["//visibility:public"],
    deps = [
        "//apps/go-svc/internal/ironsession",
