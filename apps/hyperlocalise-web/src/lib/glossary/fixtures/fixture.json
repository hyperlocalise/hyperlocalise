        {"id":"ota-037","subject":"baggage","definition":"Baggage handed to the airline for transport in the aircraft hold.","terms":[{"locale":"en","text":"checked baggage","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"checked luggage","status":"admitted"},{"locale":"vi","text":"hành lý ký gửi","status":"preferred"},{"locale":"ja","text":"受託手荷物","status":"preferred"},{"locale":"de","text":"Aufgabegepäck","status":"preferred"},{"locale":"ko","text":"위탁 수하물","status":"preferred"}]},
