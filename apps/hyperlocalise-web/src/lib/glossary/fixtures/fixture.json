        {"id":"ota-024","subject":"flight","definition":"An airline cabin offering enhanced service and space above economy.","terms":[{"locale":"en","text":"business class","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"hạng thương gia","status":"preferred"},{"locale":"ja","text":"ビジネスクラス","status":"preferred"},{"locale":"de","text":"Business Class","status":"preferred"},{"locale":"ko","text":"비즈니스 클래스","status":"preferred"}]},
        {"id":"ota-025","subject":"flight","definition":"The highest standard airline cabin with the most extensive service offering.","terms":[{"locale":"en","text":"first class","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"hạng nhất","status":"preferred"},{"locale":"ja","text":"ファーストクラス","status":"preferred"},{"locale":"de","text":"First Class","status":"preferred"},{"locale":"ko","text":"퍼스트 클래스","status":"preferred"}]},
        {"id":"ota-026","subject":"flight","definition":"A named group of fare conditions and included benefits sold by an airline.","terms":[{"locale":"en","text":"fare family","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"nhóm giá vé","status":"preferred"},{"locale":"ja","text":"運賃ファミリー","status":"preferred"},{"locale":"de","text":"Tariffamilie","status":"preferred"},{"locale":"ko","text":"운임 패밀리","status":"preferred"}]},
