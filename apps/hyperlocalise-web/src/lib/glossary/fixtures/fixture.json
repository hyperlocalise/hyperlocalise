        {"id":"ota-028","subject":"flight","definition":"The document or digital credential that allows a passenger to board a flight.","terms":[{"locale":"en","text":"boarding pass","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"thẻ lên máy bay","status":"preferred"},{"locale":"ja","text":"搭乗券","status":"preferred"},{"locale":"de","text":"Bordkarte","status":"preferred"},{"locale":"ko","text":"탑승권","status":"preferred"}]},
