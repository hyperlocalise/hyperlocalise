    "concepts": [
        {"id":"ota-001","subject":"search","definition":"The place a traveler plans to visit.","terms":[{"locale":"en","text":"destination","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"điểm đến","status":"preferred"},{"locale":"ja","text":"目的地","status":"preferred"},{"locale":"de","text":"Reiseziel","status":"preferred"},{"locale":"ko","text":"목적지","status":"preferred"}]},
        {"id":"ota-002","subject":"search","definition":"The place from which a traveler begins a journey.","terms":[{"locale":"en","text":"origin","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"điểm khởi hành","status":"preferred"},{"locale":"ja","text":"出発地","status":"preferred"},{"locale":"de","text":"Abflugort","status":"preferred"},{"locale":"ko","text":"출발지","status":"preferred"}]},
        {"id":"ota-003","subject":"search","definition":"The calendar date on which a journey begins.","terms":[{"locale":"en","text":"departure date","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"ngày khởi hành","status":"preferred"},{"locale":"ja","text":"出発日","status":"preferred"},{"locale":"de","text":"Abreisedatum","status":"preferred"},{"locale":"ko","text":"출발일","status":"preferred"}]},
        {"id":"ota-004","subject":"search","definition":"The calendar date on which a return journey begins.","terms":[{"locale":"en","text":"return date","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"return day","status":"admitted","forbidden":true,"description":"Use return date in product copy."},{"locale":"vi","text":"ngày về","status":"preferred"},{"locale":"ja","text":"復路出発日","status":"preferred"},{"locale":"de","text":"Rückreisedatum","status":"preferred"},{"locale":"ko","text":"귀국일","status":"preferred"}]},
        {"id":"ota-005","subject":"search","definition":"A search option that allows travel dates to vary around the selected period.","terms":[{"locale":"en","text":"flexible dates","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"ngày linh hoạt","status":"preferred"},{"locale":"ja","text":"日付を柔軟に設定","status":"preferred"},{"locale":"de","text":"flexible Reisedaten","status":"preferred"},{"locale":"ko","text":"유연한 날짜","status":"preferred"}]},
        {"id":"ota-006","subject":"search","definition":"Airports located close enough to the selected airport to be included in search results.","terms":[{"locale":"en","text":"nearby airports","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"sân bay lân cận","status":"preferred"},{"locale":"ja","text":"近隣の空港","status":"preferred"},{"locale":"de","text":"Flughäfen in der Nähe","status":"preferred"},{"locale":"ko","text":"인근 공항","status":"preferred"}]},
        {"id":"ota-007","subject":"flight","definition":"A flight that travels from origin to destination without landing at an intermediate airport.","terms":[{"locale":"en","text":"nonstop flight","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"direct flight","status":"admitted","description":"Allowed in informal copy, but prefer nonstop flight when no landing occurs."},{"locale":"vi","text":"chuyến bay thẳng","status":"preferred"},{"locale":"ja","text":"直行便","status":"preferred"},{"locale":"de","text":"Nonstop-Flug","status":"preferred"},{"locale":"ko","text":"직항편","status":"preferred"}]},
        {"id":"ota-008","subject":"flight","definition":"A scheduled stop between the origin and final destination of a journey.","terms":[{"locale":"en","text":"layover","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"thời gian quá cảnh","status":"preferred"},{"locale":"ja","text":"乗り継ぎ時間","status":"preferred"},{"locale":"de","text":"Aufenthalt beim Umstieg","status":"preferred"},{"locale":"ko","text":"경유 시간","status":"preferred"}]},
        {"id":"ota-009","subject":"accommodation","definition":"A place where a traveler stays overnight during a trip.","terms":[{"locale":"en","text":"accommodation","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"lodging","status":"admitted"},{"locale":"vi","text":"chỗ ở","status":"preferred"},{"locale":"ja","text":"宿泊施設","status":"preferred"},{"locale":"de","text":"Unterkunft","status":"preferred"},{"locale":"ko","text":"숙박 시설","status":"preferred"}]},
        {"id":"ota-010","subject":"accommodation","definition":"The category or configuration of a room offered by a property.","terms":[{"locale":"en","text":"room type","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"loại phòng","status":"preferred"},{"locale":"ja","text":"部屋タイプ","status":"preferred"},{"locale":"de","text":"Zimmertyp","status":"preferred"},{"locale":"ko","text":"객실 유형","status":"preferred"}]},
        {"id":"ota-011","subject":"booking","definition":"A journey that includes travel in one direction only.","terms":[{"locale":"en","text":"one-way","status":"preferred","partOfSpeech":"adjective"},{"locale":"vi","text":"một chiều","status":"preferred"},{"locale":"ja","text":"片道","status":"preferred"},{"locale":"de","text":"einfache Strecke","status":"preferred"},{"locale":"ko","text":"편도","status":"preferred"}]},
        {"id":"ota-012","subject":"booking","definition":"A journey that includes travel to a destination and back to the origin.","terms":[{"locale":"en","text":"round trip","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"return trip","status":"admitted"},{"locale":"vi","text":"khứ hồi","status":"preferred"},{"locale":"ja","text":"往復","status":"preferred"},{"locale":"de","text":"Hin- und Rückflug","status":"preferred"},{"locale":"ko","text":"왕복","status":"preferred"}]},
        {"id":"ota-013","subject":"booking","definition":"A journey that uses more than one origin-destination pair in one reservation.","terms":[{"locale":"en","text":"multi-city","status":"preferred","partOfSpeech":"adjective"},{"locale":"vi","text":"nhiều thành phố","status":"preferred"},{"locale":"ja","text":"複数都市","status":"preferred"},{"locale":"de","text":"Mehrere Städte","status":"preferred"},{"locale":"ko","text":"다구간","status":"preferred"}]},
        {"id":"ota-014","subject":"booking","definition":"A confirmed arrangement for travel or accommodation.","terms":[{"locale":"en","text":"booking","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"reservation","status":"admitted"},{"locale":"vi","text":"đặt chỗ","status":"preferred"},{"locale":"ja","text":"予約","status":"preferred"},{"locale":"de","text":"Buchung","status":"preferred"},{"locale":"ko","text":"예약","status":"preferred"}]},
        {"id":"ota-015","subject":"booking","definition":"The unique code used to identify a travel reservation.","terms":[{"locale":"en","text":"booking reference","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"reservation code","status":"admitted"},{"locale":"en","text":"PNR","status":"admitted","description":"Common industry abbreviation for passenger name record."},{"locale":"vi","text":"mã đặt chỗ","status":"preferred"},{"locale":"ja","text":"予約番号","status":"preferred"},{"locale":"de","text":"Buchungsnummer","status":"preferred"},{"locale":"ko","text":"예약 번호","status":"preferred"}]},
        {"id":"ota-016","subject":"booking","definition":"The complete sequence of travel arrangements in a reservation.","terms":[{"locale":"en","text":"itinerary","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"hành trình","status":"preferred"},{"locale":"ja","text":"旅程","status":"preferred"},{"locale":"de","text":"Reiseplan","status":"preferred"},{"locale":"ko","text":"여정","status":"preferred"}]},
        {"id":"ota-017","subject":"booking","definition":"A person who travels or is included in a travel reservation.","terms":[{"locale":"en","text":"traveler","status":"preferred","partOfSpeech":"noun"},{"locale":"en","text":"traveller","status":"admitted"},{"locale":"vi","text":"du khách","status":"preferred"},{"locale":"ja","text":"旅行者","status":"preferred"},{"locale":"de","text":"Reisende Person","status":"preferred"},{"locale":"ko","text":"여행자","status":"preferred"}]},
        {"id":"ota-018","subject":"booking","definition":"A person occupying a room or included in a hotel reservation.","terms":[{"locale":"en","text":"guest","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"khách","status":"preferred"},{"locale":"ja","text":"宿泊者","status":"preferred"},{"locale":"de","text":"Gast","status":"preferred"},{"locale":"ko","text":"투숙객","status":"preferred"}]},
        {"id":"ota-019","subject":"accommodation","definition":"The date on which a guest is scheduled to arrive at a property.","terms":[{"locale":"en","text":"check-in date","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"ngày nhận phòng","status":"preferred"},{"locale":"ja","text":"チェックイン日","status":"preferred"},{"locale":"de","text":"Check-in-Datum","status":"preferred"},{"locale":"ko","text":"체크인 날짜","status":"preferred"}]},
        {"id":"ota-020","subject":"accommodation","definition":"The date on which a guest is scheduled to leave a property.","terms":[{"locale":"en","text":"check-out date","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"ngày trả phòng","status":"preferred"},{"locale":"ja","text":"チェックアウト日","status":"preferred"},{"locale":"de","text":"Check-out-Datum","status":"preferred"},{"locale":"ko","text":"체크아웃 날짜","status":"preferred"}]},
        {"id":"ota-021","subject":"flight","definition":"The direction or class of service selected for an airline journey.","terms":[{"locale":"en","text":"cabin class","status":"preferred","partOfSpeech":"noun"},{"locale":"vi","text":"hạng khoang","status":"preferred"},{"locale":"ja","text":"客室クラス","status":"preferred"},{"locale":"de","text":"Kabinenklasse","status":"preferred"},{"locale":"ko","text":"객실 등급","status":"preferred"}]},
