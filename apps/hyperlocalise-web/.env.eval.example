# Agent eval lane credentials (vp run test:eval). Copy to .env.eval; never commit .env.eval.
# Vercel AI Gateway key used for both the system under test and the judge.
AI_GATEWAY_API_KEY=

# Optional overrides. Defaults: the production gateway model for the agent,
# a different model family for the judge (to avoid self-preference bias).
# EVAL_MODEL=openai/gpt-5.6-luna
# EVAL_JUDGE_MODEL=anthropic/claude-sonnet-4.5
