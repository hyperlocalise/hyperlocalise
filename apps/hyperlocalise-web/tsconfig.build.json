{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // TypeScript 7 re-checking against a saved .tsbuildinfo can report a false TS2589.
    "incremental": false
  },
  "exclude": [
    "node_modules",
    "src/e2e",
    "src/api/typed-app.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.fixture.ts",
    "**/*-msw-handlers.ts",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.story-view.ts",
    "**/*.story-view.tsx"
  ]
}
