{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "schedule": ["before 8am on Monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Web dependencies"
    },
    {
      "description": "chat@4.36+ statically imports async_hooks; Workflow DevKit bundles chat via @workflow/serde into a require-less VM and crashes all workflows.",
      "matchPackageNames": [
        "chat",
        "@chat-adapter/github",
        "@chat-adapter/slack",
        "@chat-adapter/state-memory",
        "@chat-adapter/state-pg",
        "@chat-adapter/web"
      ],
      "allowedVersions": "<4.36.0"
    },
    {
      "description": "@unicode/unicode-17.0.0@2.0.5+ drops Binary_Property/*/regex.js that eslint-plugin-formatjs requires.",
      "matchPackageNames": ["@unicode/unicode-17.0.0"],
      "allowedVersions": "2.0.4"
    },
    {
      "description": "Keep formatjs packages on versions compatible with eslint-plugin-formatjs until the plugin catches up.",
      "matchPackageNames": ["@formatjs/cli"],
      "allowedVersions": "<6.17.0"
    },
    {
      "description": "Keep formatjs packages on versions compatible with eslint-plugin-formatjs until the plugin catches up.",
      "matchPackageNames": ["@formatjs/ts-transformer"],
      "allowedVersions": "<4.5.0"
    },
    {
      "description": "Keep formatjs packages on versions compatible with eslint-plugin-formatjs until the plugin catches up.",
      "matchPackageNames": ["@formatjs/intl-localematcher"],
      "allowedVersions": "<0.9.0"
    },
    {
      "description": "@univerjs/slides and slides-ui are still on 1.3.x; keep the Univer stack aligned to avoid PluginCtor mismatches.",
      "matchPackageNames": ["/^@univerjs\\//"],
      "allowedVersions": "<1.4.0"
    }
  ]
}
