{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "schedule": ["before 8am on Monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Web dependencies"
    },
    {
      "description": "chat@4.36+ statically imports async_hooks; Workflow DevKit bundles chat via @workflow/serde into a require-less VM and crashes all workflows.",
      "matchPackageNames": [
        "chat",
        "@chat-adapter/github",
        "@chat-adapter/slack",
        "@chat-adapter/state-memory",
        "@chat-adapter/state-pg",
        "@chat-adapter/web"
      ],
      "allowedVersions": "<4.36.0"
    }
  ]
}
